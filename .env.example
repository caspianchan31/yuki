# Copy to .env. Sample mode stays on localhost and uses fictional data.
# Conversations are stored in this server's own database; no chat cloud is needed.
WORKSPACE_MODE=sample
AGENT_BACKEND=sample
PORT=8787
HOST=127.0.0.1
PUBLIC_API_URL=http://localhost:8787
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:5173,http://127.0.0.1:5173
DATA_DIR=.openmuse
TASK_WORKER_ENABLED=true
# Rate limiting keys on the socket address. Set true only behind a reverse proxy that
# overwrites X-Forwarded-For; otherwise callers can spoof it.
# TRUST_PROXY=false

# General delegated work: select AGENT_BACKEND=model and a provider/model.
# MODEL=openai/your-model-id
# v1.7 模型兜底: a second model that answers while the first cannot: its key's quota is gone (until
# the reset the provider states, else an hour), its key is refused (an hour), or it gives no
# answer at all (a 5xx, a relay's upstream failure, a connection that fails, a rate limit; ten
# minutes). The same provider/model form as MODEL; it may live on another gateway by another
# provider, for example "anthropic/deepseek-v4-pro" on ANTHROPIC_BASE_URL with ANTHROPIC_API_KEY
# while MODEL is "openai/…" on OPENAI_BASE_URL. The chat shows a line while the backup answers.
# MODEL_FALLBACK=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# Keyless public web search is enabled by default. Queries and task/chat context go to Parallel.
# Disable on the API and any separate task worker with WEB_SEARCH_ENABLED=false.
WEB_SEARCH_ENABLED=true
# Optional OpenAI-compatible Responses API endpoint:
# OPENAI_BASE_URL=
# Optional Anthropic endpoint override; a trailing /v1 is stripped (the SDK adds /v1 itself):
# ANTHROPIC_BASE_URL=
# Optional Google AI endpoint override; a trailing /v1beta is stripped (the SDK adds /v1beta itself):
# GOOGLE_GENERATIVE_AI_BASE_URL=
# For a gateway model ID such as vendor/model, set MODEL=openai/vendor/model.
# Providers whose /responses tool loop is incomplete (e.g. DeepSeek) can opt
# into the Chat Completions wire format instead:
# OPENAI_CHAT_COMPLETIONS=true
# Model steps per chat reply and task, 1-200 (default: chat 6; tasks 16).
# AGENT_MAX_STEPS=40
# Hard cap in minutes on one background model run (default 60). A run also fails after five
# minutes without any progress, whatever this is set to.
# AGENT_RUN_MAX_MINUTES=60
# A run that ends without a completion call (for example at the AGENT_MAX_STEPS limit) is
# continued automatically, as often as needed: there is no limit on continuations, and it never
# asks you anything. You can pause or cancel the task yourself.
# The pictures members take of the computer are kept on disk (DATA_DIR/screenshots): for this many
# days (default 90), within this many GB (default 5; the oldest go first). A deleted conversation
# takes its pictures with it.
# SCREENSHOT_RETENTION_DAYS=90
# SCREENSHOT_MAX_GB=5
# The files sent in the chat are kept on disk (DATA_DIR/attachments): for this many days
# (default 90), within this many GB (default 5; the oldest go first). A deleted conversation takes
# its files with it. Each file may be up to 10 MB.
# ATTACHMENT_RETENTION_DAYS=90
# ATTACHMENT_MAX_GB=5
# Pictures in the chat (v1.6): whether the model can draw is found out from the gateway itself
# (its record of the model, else one small try) and kept a day. Without IMAGE_MODEL the chat
# model (MODEL) is asked; set IMAGE_MODEL to draw with another model, and IMAGE_BASE_URL /
# IMAGE_API_KEY when that model lives on another gateway (else the OPENAI_* ones are used).
# IMAGE_MODEL=
# IMAGE_BASE_URL=
# IMAGE_API_KEY=
# IMAGE_EXTRA is a JSON object added to every picture request as it is: a gateway's own
# switches, such as the one that turns its watermark off.
# IMAGE_EXTRA={"watermark": false}
# IMAGE_GENERATION=off turns pictures off entirely (no check, no tool).
# A task may pause itself with wait_until (when its rules or the account's pacing say to wait, or
# to try again later after something failed) as often as it needs: there is no limit on waits,
# and a wait never asks you anything. You see the wait on the task and can pause or cancel it yourself.

# Live Google workspace: WORKSPACE_MODE=live, AGENT_BACKEND=model.
# TOKEN_ENCRYPTION_KEY=  # 32 random bytes encoded as base64
# The credential store (the mailbox you connect; docs/credentials.md) has its
# own key, required in live mode, kept in its own file and never in this file or DATA_DIR:
# a root-only file holding 32 random bytes in base64, given to the API and the worker.
# CREDENTIAL_KEY_FILE=/etc/openmuse/credential.key
# Sign-in is an admin username + password, created once on the web app's setup page with a
# one-time code (printed in the API log, or fixed here). Or create the account on first start:
# OPENMUSE_SETUP_CODE=
# OPENMUSE_ADMIN_USERNAME=
# OPENMUSE_ADMIN_PASSWORD=  # at least 8 characters
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# OAuth callback is PUBLIC_API_URL + /api/google/callback

# Optional separate task worker; all processes share DATA_DIR for PDF files.
# DATABASE_URL=postgresql://...
# Set TASK_WORKER_ENABLED=false on the API when using pnpm dev:worker.


# An optional external raw AG-UI agent replaces conversational routing only.
# AGENT_BACKEND=agui
# AGENT_URL=https://your-agent.example/run
# AGENT_TOKEN=
# OpenBot's Intelligence runtime is not this raw AG-UI URL. See its adapter docs.

# Conversations are kept in this server's database (docs/threads.md). This key
# is only read to copy conversations still in CopilotKit's cloud (Intelligence) here
# once; after that the API logs that it can be removed. A new install leaves it unset.
# CPK_INTELLIGENCE_API_KEY=

# CopilotKit SDK telemetry goes through the shared sink to PostHog, tagged OpenMuse.
# project select also writes CPK_TELEMETRY_ID: preserve that generated value and
# deploy it alongside CPK_INTELLIGENCE_API_KEY to link runtime usage to the account.
# Do not invent an identity or copy one from another project.
# CPK_TELEMETRY_ID=  # generated by the CLI; keep server-only
# Full funnel capture is the default; an explicit sample rate overrides it.
# COPILOTKIT_TELEMETRY_SAMPLE_RATE=1
# Opt out of SDK telemetry with either flag (true or 1), then restart the API:
# COPILOTKIT_TELEMETRY_DISABLED=true
# DO_NOT_TRACK=1


# Optional Jev interaction choices: off (default), sample scripted decisions, or live SDK.
JEV_MODE=off
# live sends the latest user message, agent-written context and candidate choices to TypeSafe;
# see docs/demos/jev-generative-ui.md#what-live-mode-sends-to-typesafe
# TYPESAFE_API_KEY=  # server-only; required for JEV_MODE=live
# JEV_MODEL=jev-1.13.0

# --- docker compose (docker-compose.yml; docs/computer-container.md) -------------------------------
# `docker compose up -d --build` starts the Yuki service and the members' computer. The service
# reads this file too (MODEL, the provider's API key, OPENMUSE_ADMIN_USERNAME / _PASSWORD, ...).
# Where your browser opens Yuki; change both when you change the port or the machine.
# YUKI_PORT=8787
# YUKI_PUBLIC_URL=http://localhost:8787
# Published on this machine only; set 0.0.0.0 to reach it from other machines (put TLS in front).
# YUKI_BIND=127.0.0.1
# Memory limits of the two containers.
# YUKI_MEMORY=1g
# COMPUTER_MEMORY=2g
# Shown as the web app's version (a commit id, say); empty shows none.
# YUKI_BUILD=
# Minutes without use before the computer's desktop pauses (its files stay), and its screen size.
# DESKTOP_IDLE_MINUTES=15
# v1.7: when another reply or task holds the desktop, a chat reply refuses at once (default) or
# waits up to this many seconds for its turn (0 to 600).
# DESKTOP_WAIT_SECONDS=0
# v1.7: how many of the newest replies a conversation replays when opened (the rest load as you
# scroll up); 0 replays everything.
# CHAT_REPLAY_RUNS=40
# DESKTOP_SIZE=1280x800
# Without compose, point the service at a computer container yourself:
# DESKTOP_URL=http://localhost:7070
# DESKTOP_TOKEN_FILE=/path/to/the/computer's/token
