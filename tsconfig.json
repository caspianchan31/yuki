{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "types": ["node"],
    "lib": ["ES2023", "DOM"],
    "paths": {
      "react": ["./apps/web/node_modules/@types/react"],
      "react/jsx-runtime": ["./apps/web/node_modules/@types/react/jsx-runtime"],
      "react-dom": ["./apps/web/node_modules/@types/react-dom"],
      "markdown-it": ["./apps/web/node_modules/@types/markdown-it"],
      "react-native": ["./apps/web/src/platform/react-native.d.ts"]
    }
  },
  "include": ["apps/server/**/*.ts", "packages/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "apps/mobile", "packages/client"]
}
